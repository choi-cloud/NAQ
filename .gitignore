# Ignore everything
*

# Allow directories (for recursive search)
!*/

# Track Python and Shell Script files
!*.py
!*.sh

# Keep .gitignore
!.gitignore

# Ignore Python cache
__pycache__/
*.pyc
*.pyo

# HW track (hl/hsan-weighting): allow docs/configs/results, ignore data & artifacts
!*.md
!*.json
!*.csv
!.gitkeep
!results/hw/**/*.log
out/
cache/
data/
*.pt
__pycache__/
# other tracks' local outputs on this server (not part of HW track)
results/hl/
results/nd/
save/
# HW03a: env exports and iislab4 train logs
!*.yml
!results/hw_iislab4/**/*.log
