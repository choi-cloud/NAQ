{
  "defaults": {
    "n_way": 5, "k_shot": 1, "k_shot_test": 5,
    "q_query": 10, "q_query_test": 8,
    "query_generation": "NaQ", "type": "feature",
    "lr": 1e-4, "epochs": 2000, "eval_every": 160,
    "temperature": 0.5,
    "valid_tasks": 50, "test_tasks": 500,
    "seed": 1212, "device": 0,
    "hsan": null
  },
  "arms": {
    "naq_base": { "loss": "original", "note": "L_original만 (석휘 새 계열 exp001 대응 가정, 미확인)" },
    "nbr_raw":  { "loss": "original+neighbor", "selector": "raw",  "lambda_neighbor": 0.1, "max_neighbors": 0, "note": "= zip exp015 (.sh 값)" },
    "nbr_bgrl": { "loss": "original+neighbor", "selector": "bgrl", "lambda_neighbor": 1.0, "max_neighbors": 0, "bgrl_dir": "cache/bgrl", "note": "= zip exp016 (.sh 값)" },

    "hsan_p_orig_b2":     { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 2, "space": "gcn", "logit": "euclid_gradscale" } },
    "hsan_p_both_b2":     { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "both", "beta": 2, "space": "gcn", "logit": "euclid_gradscale" } },
    "hsan_pn_orig_b2":    { "base": "nbr_raw", "hsan": { "mode": "pn", "apply": "orig", "beta": 2, "space": "gcn", "logit": "euclid_gradscale" } },
    "hsan_pn_both_b2":    { "base": "nbr_raw", "hsan": { "mode": "pn", "apply": "both", "beta": 2, "space": "gcn", "logit": "euclid_gradscale" } },
    "hsan_p_orig_b2_raw": { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 2, "space": "raw", "logit": "euclid_gradscale" } },

    "hsan_p_orig_b1_raw": { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 1, "space": "raw", "logit": "euclid_gradscale" }, "note": "HW02 2단계 (1단계 1위 hsan_p_orig_b2_raw의 beta 변형)" },
    "hsan_p_orig_b3_raw": { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 3, "space": "raw", "logit": "euclid_gradscale" }, "note": "HW02 2단계 (1단계 1위 hsan_p_orig_b2_raw의 beta 변형)" },
    "hsan_p_orig_b1":     { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 1, "space": "gcn", "logit": "euclid_gradscale" }, "note": "HW02 2단계 (1단계 2위 hsan_p_orig_b2의 beta 변형)" },
    "hsan_p_orig_b3":     { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 3, "space": "gcn", "logit": "euclid_gradscale" }, "note": "HW02 2단계 (1단계 2위 hsan_p_orig_b2의 beta 변형)" },

    "nbr_raw_cos":         { "base": "nbr_raw", "hsan": { "mode": "none", "logit": "cos_hsan", "tau_cos": 0.5 }, "note": "가중치 없음, 두 항 cos logit (cos 쌍 대조군)" },
    "hsan_pn_orig_b2_cos": { "base": "nbr_raw", "hsan": { "mode": "pn", "apply": "orig", "beta": 2, "space": "gcn", "logit": "cos_hsan", "tau_cos": 0.5 } },

    "cos_t005_none": { "base": "nbr_raw", "hsan": { "mode": "none", "logit": "cos_hsan", "tau_cos": 0.05 }, "note": "HW03a 1단계" },
    "cos_t005_p":    { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 1, "space": "gcn", "logit": "cos_hsan", "tau_cos": 0.05 }, "note": "HW03a 1단계" },
    "cos_t005_pn":   { "base": "nbr_raw", "hsan": { "mode": "pn", "apply": "orig", "beta": 1, "space": "gcn", "logit": "cos_hsan", "tau_cos": 0.05 }, "note": "HW03a 1단계" },
    "cos_t010_none": { "base": "nbr_raw", "hsan": { "mode": "none", "logit": "cos_hsan", "tau_cos": 0.10 }, "note": "HW03a 1단계" },
    "cos_t010_p":    { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 1, "space": "gcn", "logit": "cos_hsan", "tau_cos": 0.10 }, "note": "HW03a 1단계" },
    "cos_t010_pn":   { "base": "nbr_raw", "hsan": { "mode": "pn", "apply": "orig", "beta": 1, "space": "gcn", "logit": "cos_hsan", "tau_cos": 0.10 }, "note": "HW03a 1단계" },
    "cos_t020_none": { "base": "nbr_raw", "hsan": { "mode": "none", "logit": "cos_hsan", "tau_cos": 0.20 }, "note": "HW03a 1단계" },
    "cos_t020_p":    { "base": "nbr_raw", "hsan": { "mode": "p",  "apply": "orig", "beta": 1, "space": "gcn", "logit": "cos_hsan", "tau_cos": 0.20 }, "note": "HW03a 1단계" },
    "cos_t020_pn":   { "base": "nbr_raw", "hsan": { "mode": "pn", "apply": "orig", "beta": 1, "space": "gcn", "logit": "cos_hsan", "tau_cos": 0.20 }, "note": "HW03a 1단계" },
    "nbr_raw_contrast": { "base": "nbr_raw", "pick": "contrast", "note": "HW03a 1단계: argmax cos(n,support) - cos(n,query)" },
    "nbr_raw_random":   { "base": "nbr_raw", "pick": "random", "note": "HW03a 1단계: uniform eligible neighbor, dedicated generator" },
    "nbr_bgrl_l01":     { "base": "nbr_bgrl", "lambda_neighbor": 0.1, "note": "HW03a d단계: nbr_raw와 λ 같고 선택 공간만 BGRL" }
  }
}
